# Groq API key for AI chat responses
GROQ_API_KEY=

# Resend API key for lead notification emails
RESEND_API_KEY=

# Your email address — lead notifications are sent here
MY_EMAIL=

# Sending domain verified in Resend (defaults to onboarding@resend.dev in dev)
FROM_DOMAIN=

# Allowed CORS origin — set to your production frontend URL
ALLOWED_ORIGIN=https://your-portfolio-domain.com

# Port the Express server listens on (defaults to 3001)
PORT=3001
