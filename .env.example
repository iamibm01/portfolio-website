# Copy to .env.local for `npm run dev` (Vite serves api/*.ts locally with these).
# In Vercel, set the same names under Project Settings > Environment Variables.

# Claude
ANTHROPIC_API_KEY=

# Postgres. Locally, any Postgres (e.g. the Docker one in docs/chatbot-revamp-plan.md);
# on Vercel, the Neon integration sets this. Use Neon's pooled (-pooler) connection string.
DATABASE_URL=postgresql://chat:chatdev@localhost:5433/chat

# 32+ random characters each: `openssl rand -base64 48`
SESSION_SECRET=
IP_SALT=

# Comma-separated. Preview deployments (VERCEL_URL) and localhost in dev are allowed automatically.
ALLOWED_ORIGINS=https://iamibm.me,https://www.iamibm.me

# Daily Claude spend ceiling in USD; the chat rests for the day once it's reached
DAILY_BUDGET_USD=1

# Testing only: start a new chat on every page load instead of restoring the last one
VITE_CHAT_FRESH_ON_LOAD=false

# Legacy lead emails (/api/send-lead) until Phase 2 replaces them
RESEND_API_KEY=
MY_EMAIL=
# Despite the name, a full sender address on a domain verified in Resend, e.g. hello@iamibm.me
FROM_DOMAIN=
OWNER_NAME=
